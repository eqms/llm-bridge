{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLM Bridge",
  "version": "0.1.0",
  "identifier": "ai.it-guy.llmbridge",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LLM Bridge",
        "width": 1040,
        "height": 720,
        "minWidth": 780,
        "minHeight": 540,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "OpenAI-kompatibler Mini-Proxy für Anthropic-Endpunkte",
    "longDescription": "LLM Bridge übersetzt OpenAI-Chat-Completions in Anthropic-Messages, damit Tools wie MacWhisper Claude-Modelle über LangDock oder Anthropic nutzen können – mit lokaler Token-Statistik.",
    "copyright": "© 2026 Martin Schmid",
    "publisher": "Martin Schmid",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1"]
      }
    }
  }
}
